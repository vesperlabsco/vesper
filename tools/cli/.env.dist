# Copier vers tools/cli/.env (fichier gitignoré) et renseigner les valeurs.

# Intégration interne Notion (notion.so/my-integrations), partagée sur la base "Tâches".
NOTION_TOKEN=ntn_xxx

# ID de la base de données Notion "Tâches" (celle qui contient les colonnes ID / État / Type / Branche).
NOTION_DATABASE_ID=f92a9354-bd1c-8271-aef4-8144e1781367

# Branche cible des PR (optionnel, défaut "develop").
BASE_BRANCH=develop
